  },
  "icon": "icon.png",
  "homepage_url": {
    "en": "https://github.com/kojimiyazawa/kintone-image-compressor",
    "ja": "https://github.com/kojimiyazawa/kintone-image-compressor"
  },
  "desktop": {
    "js": ["desktop.js"],
    "css": []
  },
  "mobile": {
    "js": ["mobile.js"],
    "css": []
  },
  "config": {
    "html": "config.html",
    "js": ["config.js"],
    "css": ["theme.css"],
    "required_params": []
  }
}

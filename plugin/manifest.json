{
  "manifest_version": 2,
  "version": 1,
  "type": "APP",
  "name": {
    "en": "Image Compressor",
    "ja": "画像圧縮"
  },
  "description": {
    "en": "Resize and re-encode images in the browser before attaching them to an attachment field. Runs entirely in the browser with no external transmission.",
